# RYVEN Backend Configuration

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false
ENVIRONMENT=development

# CORS (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# AI Provider (Ollama - Default Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120.0

# Remote AI Inference Global Gate (Disabled by default, requires explicit opt-in)
ALLOW_REMOTE_AI_INFERENCE=false

# Hugging Face Cloud Provider (Optional / Opt-in, disabled by default)
# HF_API_KEY, HUGGINGFACE_API_KEY, or HF_TOKEN
HF_API_KEY=
HF_BASE_URL=https://api-inference.huggingface.co/v1
HF_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
HF_TIMEOUT_SECONDS=60.0

# Grok API Provider (Optional / Opt-in, disabled by default)
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest
GROK_TIMEOUT_SECONDS=60.0

# Conversation Context
MAX_HISTORY_MESSAGES=20

# Phase 3 Tool Settings
MAX_SEARCH_RESULTS=20
CLIPBOARD_MAX_LENGTH=10000
TOOL_TIMEOUT_SECONDS=10.0

# Logging
LOG_LEVEL=INFO
